   <property name="styleSheet">
    <string>
QGroupBox { font-weight: bold; border: 1px solid #b8c2cc; border-radius: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #1f4e79; }
QGroupBox QLabel, QGroupBox QLineEdit, QGroupBox QComboBox { font-weight: normal; }
QLabel[papel=&quot;subtitulo&quot;] { font-weight: bold; color: #37474f; }
QLineEdit { background: #ffffff; border: 1px solid #9aa5b1; border-radius: 3px; padding: 2px 5px; }
QLineEdit:focus { border: 1px solid #2f7fd8; }
QLineEdit[papel=&quot;saida&quot;] { background: #eceff1; color: #1f2d3a; border: 1px solid #cfd8dc; }
QLineEdit[papel=&quot;editavel&quot;] { background: #fff6d6; border: 1px solid #e0c36a; }
QComboBox { background: #ffffff; border: 1px solid #9aa5b1; border-radius: 3px; padding: 2px 5px; font-weight: normal; }
QPushButton { background: #2f7fd8; color: #ffffff; border: none; border-radius: 4px; padding: 4px 12px; min-height: 22px; font-weight: bold; }
QPushButton:hover { background: #2569b5; }
QPushButton:pressed { background: #1c548f; }
QLineEdit:disabled, QComboBox:disabled { background: #f4f4f4; color: #a0a0a0; border: 1px solid #dddddd; }
QLabel:disabled { color: #a0a0a0; }
QPushButton:disabled { background: #cfd8dc; color: #78909c; }
QGroupBox:disabled { color: #a0a0a0; }
</string>
